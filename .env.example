# ── Required ─────────────────────────────────────────────
# WalletConnect / Reown project id — free at https://dashboard.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Canonical URL of your deployment (no trailing slash).
# Used for OG images, Farcaster embeds and claim links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Chain selection ───────────────────────────────────────
# "baseSepolia" (default, testnet) or "base" (mainnet)
NEXT_PUBLIC_CHAIN=baseSepolia

# Contract addresses (Base Sepolia default is built in)
# NEXT_PUBLIC_POAP_ADDRESS_BASE_SEPOLIA=0xC3249356a483fbe17d5355D39105D2eA666d9de6
# NEXT_PUBLIC_POAP_ADDRESS_BASE=

# Optional dedicated RPCs (recommended in production)
# NEXT_PUBLIC_RPC_BASE_SEPOLIA=
# NEXT_PUBLIC_RPC_BASE=

# ── Farcaster Mini App (production only) ─────────────────
# Domain account-association — generate with Farcaster dev tools
# for YOUR domain, see DEPLOYMENT.md
NEXT_PUBLIC_FC_HEADER=
NEXT_PUBLIC_FC_PAYLOAD=
NEXT_PUBLIC_FC_SIGNATURE=
